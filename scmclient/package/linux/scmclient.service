[Unit]
Description=OpenSCM Agent
Documentation=https://openscm.io/docs
After=network.target

[Service]
Type=simple
User=root

ExecStart=/usr/bin/scmclient
WorkingDirectory=/etc/openscm

Restart=on-failure
RestartSec=5s

# Safety net. The agent's working set is tens of MB; these caps exist so a
# regression in it can never pressure the workloads it is meant to monitor.
# MemoryHigh throttles and reclaims first, MemoryMax is the hard stop.
MemoryHigh=256M
MemoryMax=512M
StartLimitIntervalSec=60s
StartLimitBurst=3

# Logs
StandardOutput=append:/var/log/openscm/scmclient.log
StandardError=append:/var/log/openscm/scmclient_error.log

[Install]
WantedBy=multi-user.target
